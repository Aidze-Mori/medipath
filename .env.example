# Без ключа работают загрузка, OCR и локальные демосценарии.
LLM_PROVIDER=disabled
HOST=127.0.0.1
PORT=3001
VITE_DEMO_ENABLED=true

# Для AI замените disabled на openai и заполните свой ключ и модель.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# Для VseLLM: https://api.vsellm.ru/v1; модель указывается с префиксом openai/.
ALLOW_LOCAL_LIVE=1
ALLOW_ANONYMIZED_DOCUMENTS=1
# На Netlify для разбора загруженных документов нужен отдельный opt-in.
ALLOW_CLOUD_DOCUMENTS=0
# Для небольшого демостенда без Redis. Не общий публичный тарифный лимит.
DEMO_WITHOUT_REDIS=1
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Альтернативный локальный provider: codex_cli, нужен установленный Codex CLI.
CODEX_MODEL=
CODEX_CLI_PATH=
